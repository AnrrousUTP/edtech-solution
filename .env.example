# Copia a .env y ajusta si hace falta. .env NUNCA se versiona (D17).
DATABASE_URL=postgres://svc_<servicio>:local@postgres:5432/edtech
AWS_ENDPOINT_URL=http://localstack:4566
# Descomentar solo para activar las suites locales DynamoDB Local.
# DYNAMODB_LOCAL_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=edtech-domain-events
COGNITO_ISSUER=http://jwt-local:4599
# Pagos locales usan una pasarela determinista; producción requiere PayPal real.
PAYPAL_LOCAL_MODE=true
# Solo para desarrollo local; en AWS debe omitirse.
EDTECH_LOCAL_AUTH=true
EDTECH_AFFILIATES_ENABLED=false
GENERADOR_FLASHCARDS=fake
LOG_LEVEL=debug

# Asistente EdTech (solo servidor; no usar NEXT_PUBLIC_).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
