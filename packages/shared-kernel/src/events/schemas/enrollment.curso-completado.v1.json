{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edtech.solution/events/enrollment.curso-completado.v1.json",
  "title": "enrollment.curso-completado.v1",
  "type": "object",
  "required": ["matriculaId", "usuarioId", "cursoId", "cursoTitulo", "completadoAt"],
  "properties": {
    "nivelMax": {
      "type": "string",
      "pattern": "^[A-N]$",
      "description": "Campo opcional agregado (A-11): identity lo usa para subir el nivel (regla max, doc 02 §2) sin consultar a catalog"
    },
    "matriculaId": {
      "type": "string",
      "format": "uuid"
    },
    "usuarioId": {
      "type": "string",
      "format": "uuid"
    },
    "cursoId": {
      "type": "string",
      "format": "uuid"
    },
    "cursoTitulo": {
      "type": "string",
      "minLength": 1
    },
    "completadoAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
