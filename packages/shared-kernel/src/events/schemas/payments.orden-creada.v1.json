{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edtech.solution/events/payments.orden-creada.v1.json",
  "title": "payments.orden-creada.v1",
  "type": "object",
  "required": ["ordenId", "usuarioId", "cursoId", "monto", "moneda"],
  "properties": {
    "ordenId": {
      "type": "string",
      "format": "uuid"
    },
    "usuarioId": {
      "type": "string",
      "format": "uuid"
    },
    "cursoId": {
      "type": "string",
      "format": "uuid"
    },
    "monto": {
      "type": "number"
    },
    "moneda": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
