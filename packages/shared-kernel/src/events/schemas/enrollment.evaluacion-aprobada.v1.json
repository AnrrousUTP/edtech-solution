      "type": "string",
      "format": "uuid"
    },
    "tomoId": {
      "type": "string",
      "format": "uuid"
    },
    "puntaje": {
      "type": "integer",
      "minimum": 0
    },
    "perfecto": {
      "type": "boolean"
    }
  }
}
