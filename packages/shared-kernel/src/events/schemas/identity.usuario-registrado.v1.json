{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edtech.solution/events/identity.usuario-registrado.v1.json",
  "title": "identity.usuario-registrado.v1",
  "type": "object",
  "required": ["usuarioId", "email", "nombreVisible", "rol"],
  "properties": {
    "usuarioId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "nombreVisible": {
      "type": "string",
      "minLength": 1
    },
    "rol": {
      "enum": ["ESTUDIANTE", "ADMIN"]
    }
  }
}
