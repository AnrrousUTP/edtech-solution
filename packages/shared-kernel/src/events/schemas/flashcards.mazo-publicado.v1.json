      "format": "uuid"
    },
    "cursoId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "cantidadPublicadas": {
      "type": "integer",
      "minimum": 0
    }
  }
}
